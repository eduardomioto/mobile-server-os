#!/usr/bin/env python3
"""
Mobile Server OS — Painel de status nativo no framebuffer (/dev/fb0).
Exibe informações em tempo real na tela física do aparelho (CPU, RAM, Disco,
Temperaturas, Bateria, Wi-Fi, IP, SSH, Painel Web e estado dos serviços runit).
Controles pelos botões físicos (gpio_keys):
  - Botão Power    : liga / desliga a tela (economia de energia)
  - Volume + / -   : aumenta / diminui o brilho da tela
"""
import fcntl
import glob
import json
import mmap
import os
import select
import shutil
import socket
import struct
import subprocess
import time

